# =====================================================================
#  設定範例。使用方式：
#      cp .env.example .env      （Windows：copy .env.example .env）
#  然後把 .env 裡的值換成你自己的。
#
#  ⚠️ .env 放的是秘密（Discord token、Gemini API key），已被 .gitignore 擋住，
#     絕對不要 commit、不要貼到 issue / 截圖 / 聊天室。
#     這個檔案（.env.example）只放說明與假的範例值，可以公開。
#  只有「必填」的兩項沒填，bot 就開不起來；其他都有預設值。
# =====================================================================

# ---------- 必填 ----------
# 雅斯寶寶（IELTS）的 Discord bot token。
# 取得方式：https://discord.com/developers/applications → New Application → 左側 Bot →
#   Reset Token（只會顯示一次，請馬上複製）。同一頁往下把 "Message Content Intent" 打開。
DISCORD_TOKEN=your_discord_bot_token

# Google Gemini API key。取得方式：https://aistudio.google.com/apikey（有免費額度）
GEMINI_API_KEY=your_gemini_api_key


# ---------- 強烈建議填 ----------
# 你的 Discord 伺服器 ID。填了之後 slash command 會「立即」出現在該伺服器（不填要等全域同步，最久 1 小時），
# 而且預設 bot 只允許待在這個伺服器（被別人邀進其他伺服器會自動退出，避免陌生人消耗你的 Gemini 額度）。
# 取得方式：Discord 設定 → 進階 → 打開「開發者模式」→ 對伺服器圖示按右鍵 → 複製伺服器 ID。
DISCORD_GUILD_ID=

# 管理員的 Discord 使用者 ID（可用 /users /block /unblock、看全域用量）。
# 取得方式：開發者模式 → 對自己的頭像按右鍵 → 複製使用者 ID。全新安裝沒填就沒有管理員（只有從舊的單人資料庫升級時才會自動推斷）。
OWNER_ID=

# 允許 bot 待著的伺服器（逗號分隔多個伺服器 ID）。沒填就等於只允許上面的 DISCORD_GUILD_ID。
ALLOWED_GUILD_IDS=


# ---------- 德語寶寶（第二隻 bot，選填）----------
# 用 python run_all.py 同時啟動兩隻 bot；沒填 GERMAN_DISCORD_TOKEN 就只啟動雅斯寶寶。
# 要在 Discord Developer Portal「另外建立一個 Application / Bot」，把它的 token 填在這裡。
GERMAN_DISCORD_TOKEN=

# 每天自動發送「今日德語例句」的頻道 ID（開發者模式 → 對頻道按右鍵 → 複製頻道 ID）。
# 不填就不自動發，使用者仍可用 /de_today 取得。
GERMAN_DAILY_CHANNEL_ID=
# 每天幾點發（執行 bot 那台電腦的本機時間，24 小時制）與例句的程度（A1 A2 B1 B2 C1）
GERMAN_DAILY_TIME=08:00
GERMAN_DAILY_LEVEL=A2

# 德語語音模型（Piper，本地）。同資料夾裡其他有 .json 設定檔的 .onnx 會自動加入、輪流當「老師」的聲音。
GERMAN_VOICE_MODEL=models/de/de_DE-thorsten-medium.onnx
# 設 0 就只用上面一個聲音
GERMAN_MULTI_VOICE=1


# ---------- Gemini 模型與用量防護 ----------
GEMINI_MODEL=gemini-3.5-flash-lite
# 主模型回 503（過載）時自動改用的備援模型；留空＝不備援
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# 全域每分鐘 / 每日呼叫上限、單一使用者每分鐘上限。預設對應 flash-lite 免費額度（15 RPM / 500 RPD）並留餘裕；
# 換模型或升級付費方案時請依你的額度調整。
GEMINI_RPM_LIMIT=12
GEMINI_RPD_LIMIT=450
USER_RPM_LIMIT=8


# ---------- 練習行為 ----------
# 單字測驗、閱讀、聽力、口說這類持續性互動，這麼多分鐘沒回應就自動結束並評分
SESSION_IDLE_MINUTES=10
# 你目前的雅思程度（band）；沒有人 /register 過時，/word_quiz 以它生成適合的新單字
IELTS_LEVEL=5.5
# 聽力模擬測驗：貼完題目卷後，給考生讀題的秒數
LISTEN_PREVIEW_SECONDS=30

# 閱讀「真實文章改編」的來源（逗號分隔）。皆為開放授權／公有領域：
#   owid, nasa, nist, globalvoices, wikipedia, wikinews, wikivoyage
# （不收錄 BBC：它的 robots.txt 明文禁止爬取與 AI 使用）
READING_SOURCES=owid,nasa,nist,globalvoices,wikipedia,wikinews,wikivoyage
# 維基百科／維基新聞要求程式在 User-Agent 附上聯絡方式（信箱或網址）。沒填就不使用這兩個來源。
# ⚠️ 這個值會被送到維基媒體的伺服器，請填你願意公開的信箱或網址（或乾脆留空）。
READING_CONTACT=

# 口說「對話追問」：本機語音辨識模型（small.en 準確、約 480MB，第一次使用時自動下載；base.en 較快較小）
# 與每場最多讓 Gemini 即時接話幾次
WHISPER_MODEL=small.en
DIALOGUE_MAX_LIVE=1


# ---------- 檔案位置與保存天數（通常不用改）----------
# 資料庫（SQLite）檔案；裡面有所有使用者的作答與評級，已被 .gitignore 擋住，請自行備份
DB_FILE=ielts_learning.db
LOG_DIR=logs
# Gemini 提示詞與回應原文的保存天數（內含使用者輸入的內容；設 0 就完全不保存）
PAYLOAD_RETENTION_DAYS=30
# 使用紀錄（指令、錯誤）的保存天數
EVENT_RETENTION_DAYS=365
